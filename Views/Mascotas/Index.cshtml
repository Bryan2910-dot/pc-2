@model pc_2.Models.Mascotas

@{
    ViewBag.Title = "Crear Mascota";
}

<h1>Crear Mascota</h1>

<form method="post" asp-action="Guardar">
    <div class="form-group">
        <label for="nombre">Nombre</label>
        <input type="text" class="form-control" id="nombre" name="Nombre" required />
        <span class="text-danger" asp-validation-for="Nombre"></span>
    </div>
    <div class="form-group mt-2">
        <label for="edad">Edad</label>
        <input type="text" class="form-control" id="edad" name="Edad" required />
        <span class="text-danger" asp-validation-for="Edad"></span>
    </div>
    <div class="form-group mt-2">
        <label for="tipo">Tipo</label>
        <input type="text" class="form-control" id="tipo" name="Tipo" required />
        <span class="text-danger" asp-validation-for="Tipo"></span>
    </div>
    <div class="form-group mt-2">
        <label for="estado">Estado</label>
        <select class="form-control" id="estado" name="Estado" required>
            <option value="">Seleccione un estado</option>
            <option value="Disponible">Disponible</option>
            <option value="Adoptada">Adoptada</option>
        </select>
        <span class="text-danger" asp-validation-for="Estado"></span>
    </div>
    
    <button type="submit" class="btn btn-primary mt-2">Guardar</button>
</form>

<h1>@ViewData["Mensaje"]</h1>